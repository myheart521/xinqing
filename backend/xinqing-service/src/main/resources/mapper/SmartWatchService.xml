<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hpu.xinqing.mapper.PermissionMapper">


    <select id="getPermissionByPermissionIds" resultType="java.lang.String">
        select permission_name from permission where in
        <foreach collection="rolePermissions" item="rolePermission" open="(" close=")" separator=",">
            #{rolePermission.permissionId}
        </foreach>
    </select>
</mapper>
