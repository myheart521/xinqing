<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hpu.xinqing.mapper.ActivityFollowMapper">

    <select id="selectTopParticipants" resultType="com.hpu.xinqingpojo.VO.DataVo">
        SELECT
            u.user_name AS name,
            COUNT(af.id) AS value
        FROM activity_follow af
                 JOIN user u ON af.user_id = u.id
        GROUP BY af.user_id
        ORDER BY value DESC
        LIMIT 5
    </select>
</mapper>
