# Public defaults. Set secrets in your process/IDE/container environment.
# Required variable: BAIDU_MAP_API_KEY
# Required variable: DASHSCOPE_API_KEY
# Required variable: DASHSCOPE_APP_ID
# Required variable: LANGCHAIN4J_COMMUNITY_DASHSCOPE_CHAT_MODEL_API_KEY
