# Required variable: LANGCHAIN4J_COMMUNITY_DASHSCOPE_STREAMING_CHAT_MODEL_API_KEY
MYSQL_DATABASE=xinqing
MYSQL_HOST=localhost
# Required variable: MYSQL_PASSWORD
# Required variable: MYSQL_USER
# Required variable: SA_TOKEN_JWT_SECRET_KEY
# Required variable: SEARCH_API_KEY
# Required variable: SMTP_ACCOUNT
# Required variable: SMTP_HOST
# Required variable: SMTP_PASSWORD
# Required variable: SPRING_AI_OPENAI_API_KEY
SPRING_AI_OPENAI_BASE_URL=http://localhost:11434/v1
SPRING_AI_OPENAI_MODEL=qwen2.5:3b
# Required variable: SPRING_DATASOURCE_PASSWORD
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/xinqing?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# Required variable: SPRING_DATASOURCE_USERNAME
SPRING_DATA_REDIS_HOST=localhost
# Required variable: SPRING_DATA_REDIS_PASSWORD
SPRING_RABBITMQ_HOST=localhost
# Required variable: SPRING_RABBITMQ_PASSWORD
# Required variable: SPRING_RABBITMQ_USERNAME
# Required variable: XINQING_ALIOSS_ACCESS_KEY_ID
# Required variable: XINQING_ALIOSS_ACCESS_KEY_SECRET
# Required variable: XINQING_ALIOSS_BUCKET_NAME
# Required variable: XINQING_ALIOSS_ENDPOINT
# Required variable: XINQING_HUAWEI_IOT_DEVICE_ID
# Required variable: XINQING_HUAWEI_IOT_ENDPOINT
# Required variable: XINQING_HUAWEI_IOT_IAM_ACCOUNT
# Required variable: XINQING_HUAWEI_IOT_PASSWORD
# Required variable: XINQING_HUAWEI_IOT_PROJECT_ID
# Required variable: XINQING_HUAWEI_IOT_TOKEN_URL
# Required variable: XINQING_HUAWEI_IOT_USERNAME
# Required variable: XINQING_WECHAT_APPID
# Required variable: XINQING_WECHAT_SECRET

# Restored model configuration and optional server-side speech authorization
XINQING_MENTAL_WARNING_BASE_URL=http://127.0.0.1:48084/v1
XINQING_MENTAL_WARNING_API_KEY=""
XINQING_MENTAL_WARNING_MODEL=psych-qwen2.5-3b-lora
XINQING_MENTAL_WARNING_TEMPERATURE=0.2
XINQING_MENTAL_WARNING_TIMEOUT_SECONDS=120
XINQING_MENTAL_WARNING_MAX_RETRIES=2
XINQING_MENTAL_WARNING_MAX_TOKENS=2048
XINQING_ASR_ENABLED=false
XINQING_ASR_APP_ID=""
XINQING_ASR_API_KEY="" # Set your own key locally when enabling ASR.
XINQING_ASR_API_SECRET=""
